# ResumeIQ Enterprise — environment variables
# Copy to .env and fill in for local dev. Mount as Kubernetes Secret in prod.

# --- Public (bundled into client) ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=ResumeIQ
VITE_APP_ENV=development

# --- Server-only ---
APP_VERSION=0.1.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://resumeiq:resumeiq@postgres:5432/resumeiq

# AI / LLM gateway
LLM_PROVIDER=openai
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# Auth
JWT_SECRET=replace-with-strong-secret
SESSION_SECRET=replace-with-strong-secret

# Object storage (resume uploads)
STORAGE_BUCKET=resumeiq-uploads
STORAGE_REGION=eastus

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
